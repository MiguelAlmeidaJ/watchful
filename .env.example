POSTGRES_USER=watchful
POSTGRES_PASSWORD=local_dev_only
POSTGRES_DB=watchful
DATABASE_URL=postgresql://watchful:local_dev_only@localhost:5432/watchful
REDIS_CACHE_URL=redis://localhost:6379
REDIS_QUEUE_URL=redis://localhost:6380
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# Generate a unique random secret of at least 32 bytes before starting API
JWT_SECRET=
# Temporary bootstrap credentials; remove after use
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Enable only after provider access and usage terms are verified
WEATHER_INGESTION_ENABLED=false
WEATHER_OBSERVATIONS_ENABLED=false
WEATHER_FORECASTS_ENABLED=false
ANA_INGESTION_ENABLED=false
# HidroWebService: diagnostic only until authenticated payload and quality mapping are validated
ANA_HIDROWEB_USERNAME=
ANA_HIDROWEB_PASSWORD=
# Optional commercial Open-Meteo endpoint and credential
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_API_KEY=

# Internal pilot only; keep disabled until criteria and providers are validated
RISK_EVALUATION_ENABLED=false
ALERT_INTERNAL_PUBLICATION_ENABLED=false

# Optional licensed basemap style; empty means geometry-only map
NEXT_PUBLIC_MAP_STYLE_URL=
EXPO_PUBLIC_MAP_STYLE_URL=
