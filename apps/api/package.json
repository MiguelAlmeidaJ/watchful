{
  "name": "@watchful/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "dev:serve": "node --watch dist/main.js",
    "admin:bootstrap": "tsx src/scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "dotenv": "^16.5.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "pg": "^8.16.0",
    "zod": "^3.25.0",
    "jose": "^5.10.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "~5.8.3",
    "@types/pg": "^8.15.0",
    "@types/express": "^5.0.0"
  }
}
